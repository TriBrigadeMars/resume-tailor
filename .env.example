# ResumeTailor environment variables.
# Copy this file to `.env` and adjust as needed. The app reads these at startup.
# NOTE: API keys for OpenRouter / LM Studio / search providers are entered in
# the web UI and stored only in the browser — do NOT put them here.

# Bind address and port
HOST=127.0.0.1
PORT=8000

# Set to 0 to prevent the app from auto-opening a browser (used in containers)
AUTO_OPEN_BROWSER=1

# Local LLM backend endpoints
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234

# Optional default job RSS feed URL (prefilled in the UI)
RSS_FEED_URL=

# Optional JSON list of MCP servers, e.g.:
# [{"name":"web","type":"http","url":"http://host:port/mcp"},
#  {"name":"fs","type":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
MCP_SERVERS=[]

# Allow the browser to supply MCP server config (default 0 = disabled).
# The trusted local desktop app sets this to 1 automatically.
ALLOW_CLIENT_MCP_SERVERS=0
